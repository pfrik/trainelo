# Supabase Configuration
# Get these values from your Supabase project dashboard
# https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Optional: Project ID (not used in client code but good for reference)
VITE_SUPABASE_PROJECT_ID=your-project-id

# Anthropic API key (for LLM coaching explanations)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Feature flags (all default to false)
VITE_ENABLE_LLM=false
VITE_ENABLE_CALIBRATION_AUTO_APPLY=false
VITE_ENABLE_EVIDENCE_PANEL=false